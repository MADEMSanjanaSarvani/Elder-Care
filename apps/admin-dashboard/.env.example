# Public — safe to expose to the browser (RLS is the actual security
# boundary; the anon key only ever grants what the signed-in admin's own
# RLS policies allow — see supabase/migrations/0002_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by the handful of Server Actions that need to call a
# third-party API with a secret. Never referenced from a Client Component.
# See lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay standard/payment-gateway keys — same pair used by
# supabase/functions/payments-create-order. Needed here for the refund
# action on a disputed booking.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# RazorpayX payout keys — for retrying a failed caregiver payout.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
