<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for Supabase. Without this a release build has no
         connectivity at all — login and every screen would silently fail. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Location for the SOS flow (geolocator captures the elder's position
         when notifying family + ops). Coarse is an acceptable fallback. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13+ requires an explicit runtime permission to show
         notifications (FCM push). Older versions grant it implicitly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Video consultations (Agora): camera, microphone and audio routing. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>

    <!-- Exact, on-device dose reminders (flutter_local_notifications).

         USE_EXACT_ALARM rather than SCHEDULE_EXACT_ALARM: from Android 14 the
         latter must be granted by the user in a settings screen most people
         never find, and an ungranted exact alarm is silently downgraded to a
         batched one — a dose reminder that arrives "sometime this hour", which
         is the precise failure we moved off the server cron to avoid.
         USE_EXACT_ALARM is granted at install for apps whose core function is
         alarms or reminders. A medicine reminder is squarely that, and Play
         asks you to justify it at submission; the justification is this app's
         entire purpose.

         RECEIVE_BOOT_COMPLETED so alarms survive a restart. Without it a phone
         that reboots overnight goes quiet, and nobody notices until a dose is
         already missed. VIBRATE so the reminder is felt when the phone is on
         silent, which for an older user it very often is. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:label="CareHive"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link for Supabase Auth callbacks (password reset today,
                 email confirmation later). Without this the emailed link has
                 nowhere to land and falls back to the project's Site URL,
                 which is http://localhost:3000 on a fresh project. Keep in
                 sync with kPasswordResetRedirect in auth_repository.dart. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="in.carehive.app" android:host="auth"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Re-registers scheduled alarms after a reboot. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Delivers the alarm itself. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <!-- Handles the "Taken" button. exported=false because nothing outside
             this app has any business recording that a dose was swallowed. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher opens the dialer for "Call 108". Android 11+ package
             visibility hides the dialer unless we declare this intent. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
